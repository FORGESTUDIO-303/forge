PORT=3000
JWT_SECRET=forge-dev-secret-change-in-november
# Local PG (role: forge) / November hosted: set DATABASE_URL=...
# DATABASE_URL=postgres://forge:forge-local-dev@localhost:5432/forge
# Public URLs (Vercel backend + github.io site)
# API_URL=https://forge-puce-rho.vercel.app
# SITE_URL=https://forgestudio-303.github.io/forge
# Google: console.cloud.google.com → Credentials → OAuth client.
#   Authorized redirect: <API_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps.
#   Callback: <API_URL>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Stripe (November): checkout stays stubbed until this is set
# STRIPE_SECRET_KEY=
